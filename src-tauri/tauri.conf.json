{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cc-assist",
  "version": "0.1.0",
  "identifier": "com.gmail.karoyqiu.cc-assist",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "cc-assist",
        "label": "main",
        "width": 700,
        "height": 500,
        "resizable": true,
        "center": true,
        "minWidth": 500,
        "minHeight": 300
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
